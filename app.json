{
  "expo": {
    "name": "xeuysil-mobile",
    "slug": "xeuysil-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "xeuysilmobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "name": "XeuySil",
      "shortName": "XeuySil",
      "description": "Trouvez du travail ou des travailleurs journaliers près de chez vous au Sénégal — en moins de 2 heures.",
      "themeColor": "#1a6b2a",
      "backgroundColor": "#f4f8f4",
      "meta": {
        "og:type":        "website",
        "og:title":       "XeuySil — Travaillez. Trouvez. Avancez.",
        "og:description": "Plateforme de mise en relation entre recruteurs et travailleurs journaliers au Sénégal. Maçons, jardiniers, lessiveuses, manutentionnaires — en moins de 2 heures.",
        "og:image":       "https://xeuysil-client.onrender.com/og-image.png",
        "og:image:width": "1080",
        "og:image:height":"1080",
        "og:url":         "https://xeuysil-client.onrender.com",
        "og:site_name":   "XeuySil",
        "og:locale":      "fr_SN",
        "twitter:card":   "summary",
        "twitter:title":  "XeuySil — Viens travailler",
        "twitter:description": "Trouvez du travail ou des travailleurs journaliers au Sénégal.",
        "twitter:image":  "https://xeuysil-client.onrender.com/og-image.png"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
