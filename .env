# Copiez ce fichier en .env puis mettez l'adresse IP de VOTRE ordinateur (commande ipconfig, ligne IPv4).
# Prism (mock) : port 4010. Plus tard : l'adresse de la passerelle du vrai backend.
EXPO_PUBLIC_API_URL=http://172.20.10.9:3000/api/v1
EXPO_PUBLIC_API_URL_WEB=http://localhost:3000/api/v1
# Route masquée de connexion administrateur. La sécurité réelle reste portée par AdminGuard côté API.
EXPO_PUBLIC_ADMIN_ROUTE=backoffice-acces